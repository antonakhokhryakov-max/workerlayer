# BYOM. Optional. WorkerLayer does not host models and does not sell tokens.
# If you set a key, it is your credential and your bill. Without a key,
# the reference worker uses a deterministic local planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required for /api/v1. Identity / principal only — never grants tools.
# Send Authorization: Bearer or X-Api-Key. Desk does not use this.
# Optional extra principals (comma-separated). Each key is its own identity.
# Bob cannot read Alice's task — 404, not a grant. Desk still does not use these.
# Alpha — not for sensitive production workloads.
AETHER_API_KEY=replace-me
# AETHER_API_KEYS=bob-secret

# Where task workspaces, artifacts, and audit logs are stored.
AETHER_DATA_DIR=./data

# Fork Split — set this ONLY on the Vercel control surface.
# Never set it on the Mac mini host. Never a Vercel URL.
# Point it at the mini's reachable pnpm start URL so /api proxies there.
# Workers / startTask / Manifest exec never run on Vercel.
# WORKERLAYER_HOST_URL=https://mini-host.example
